#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball { scroll-layers = <4>; };

/ {
    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
        compatible = "zmk,macros";

        cmd_tab_hold: cmd_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "CMD_TAB_HOLD";
        };

        win_alt_tab: win_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WIN_ALT_TAB";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&bt BT_DISC 1>;

            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 0 &bt BT_DISC 0>;

            label = "BT1";
        };
    };

    combos {
        compatible = "zmk,combos";

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
            layers = <1>;
        };

        win_MB2 {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN_LAYER {
            bindings = <
&lt 3 Q       &kp W         &kp E    &kp R                      &kp T                                                        &kp Y        &kp U  &kp I     &kp O        &kp P
&kp A         &kp S         &kp D    &kp F                      &kp G                        &kp COMMA          &kp PERIOD   &kp H        &kp J  &kp K     &kp L        &kp MINUS
&mt LSHIFT Z  &kp X         &kp C    &kp V                      &kp B                        &kp ESCAPE         &kp TAB      &kp N        &kp M  &mkp MB1  &lt 2 SLASH  &mt RIGHT_SHIFT QMARK
&kp LEFT_GUI  &win_alt_tab  &kp TAB  &mt LEFT_ALT INT_MUHENKAN  &mt LEFT_CONTROL INT_HENKAN  &kp BACKSPACE      &lt 5 SPACE  &lt 4 ENTER                                &kp DELETE
            >;
        };

        MAC_LAYER {
            bindings = <
&lt 3 Q           &kp W          &kp E    &kp R                    &kp T                                                    &kp Y        &kp U  &kp I     &kp O        &kp P
&kp A             &kp S          &kp D    &kp F                    &kp G                    &kp COMMA          &kp PERIOD   &kp H        &kp J  &kp K     &kp L        &kp MINUS
&mt LSHIFT Z      &kp X          &kp C    &kp V                    &kp B                    &kp ESCAPE         &kp TAB      &kp N        &kp M  &mkp MB1  &lt 2 SLASH  &mt RIGHT_SHIFT QMARK
&kp LEFT_CONTROL  &cmd_tab_hold  &kp TAB  &mt LEFT_ALT LANGUAGE_2  &mt LEFT_GUI LANGUAGE_1  &kp BACKSPACE      &lt 7 SPACE  &lt 6 ENTER                                &kp LG(BACKSPACE)
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FN {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        WIN_SYMNUM {
            bindings = <
&kp AMPERSAND               &kp ASTERISK  &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                                       &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp N0
&kp DOLLAR                  &kp PERCENT   &kp CARET  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOUBLE_QUOTES      &kp ASTERISK  &kp PLUS   &kp N4  &kp N5  &kp N6  &kp UNDERSCORE
&mt LEFT_SHIFT EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp COLON             &kp SEMICOLON          &kp SQT                &kp SLASH     &kp MINUS  &kp N1  &kp N2  &kp N3  &mt RIGHT_SHIFT NON_US_BACKSLASH
&trans                      &trans        &trans     &trans                &trans                 &trans                 &trans        &trans                             &trans
            >;
        };

        WIN_MOVE {
            bindings = <
&trans  &trans              &kp LG(UP_ARROW)    &trans               &trans                      &trans    &kp LS(LC(TAB))     &kp UP_ARROW    &kp LC(TAB)          &kp LG(LS(LEFT_ARROW))
&trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans      &trans  &kp HOME  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans    &kp LA(LEFT_ARROW)  &kp LG(TAB)     &kp LA(RIGHT_ARROW)  &trans
&bt0    &bt1                &bt BT_CLR          &trans               &trans  &trans      &trans  &trans                                                             &trans
            >;
        };

        MAC_SYMNUM {
            bindings = <
&kp AMPERSAND               &kp ASTERISK  &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                                       &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp N0
&kp DOLLAR                  &kp PERCENT   &kp CARET  &kp LBKT              &kp RBKT               &kp DOUBLE_QUOTES      &kp ASTERISK  &kp PLUS   &kp N4  &kp N5  &kp N6  &kp UNDERSCORE
&mt LEFT_SHIFT EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp COLON             &kp SEMICOLON          &kp SQT                &kp SLASH     &kp MINUS  &kp N1  &kp N2  &kp N3  &mt RIGHT_SHIFT BACKSLASH
&trans                      &trans        &trans     &trans                &trans                 &trans                 &trans        &trans                             &trans
            >;
        };

        MAC_MOVE {
            bindings = <
&trans  &trans  &trans      &trans  &trans                      &kp LC(LEFT_ARROW)  &kp LC(LS(TAB))       &kp UP_ARROW      &kp LC(TAB)            &kp LC(RIGHT_ARROW)
&trans  &trans  &trans      &trans  &trans  &trans      &trans  &kp LG(LEFT_ARROW)  &kp LEFT_ARROW        &kp DOWN_ARROW    &kp RIGHT_ARROW        &kp LG(RIGHT_ARROW)
&trans  &trans  &trans      &trans  &trans  &trans      &trans  &trans              &kp LG(LEFT_BRACKET)  &kp LC(UP_ARROW)  &kp LG(RIGHT_BRACKET)  &trans
&bt0    &bt1    &bt BT_CLR  &trans  &trans  &trans      &trans  &trans                                                                             &trans
            >;
        };
    };
};
