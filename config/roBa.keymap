#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 5

&mkp_input_listener { input-processors = <&zip_temp_layer 5 10000>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball { scroll-layers = <6>; };

/ {
    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };
    };

    macros {
        compatible = "zmk,macros";

        cmd_tab_hold: cmd_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "CMD_TAB_HOLD";
        };

        win_alt_tab: win_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WIN_ALT_TAB";
        };

        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off 7>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    combos {
        compatible = "zmk,combos";

        eisu {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <2 1>;
        };

        kana {
            bindings = <&kp INTERNATIONAL_4>;
            key-positions = <7 8>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <31 32>;
        };

        abc {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <1 2>;
            timeout-ms = <0>;
            layers = <1>;
        };

        aiu {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <7 8>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN_LAYER {
            bindings = <
&kp Q                         &kp W         &kp E            &kp R                &kp T                                                                 &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A                         &kp S         &lt 3 D          &lt 2 F              &kp G                                   &none          &none          &kp H        &kp J  &kp K      &lt 8 L     &kp MINUS
&mt_exit_AML_on_tap LSHIFT Z  &kp X         &kp C            &kp V                &kp B                                   &none          &none          &kp N        &kp M  &kp COMMA  &kp PERIOD  &mt_exit_AML_on_tap RIGHT_SHIFT QUESTION
&kp LEFT_GUI                  &win_alt_tab  &kp PRINTSCREEN  &mt LEFT_ALT ESCAPE  &mt_exit_AML_on_tap LEFT_CONTROL SPACE  &lt 4 TAB      &kp BACKSPACE  &lt 5 ENTER                                &kp DELETE
            >;
        };

        MAC_LAYER {
            bindings = <
&kp Q                             &kp W          &kp E                 &kp R                &kp T                                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A                             &kp S          &lt 3 D               &lt 2 F              &kp G                                   &none          &none          &kp H        &kp J  &kp K      &lt 8 L  &kp MINUS
&mt_exit_AML_on_tap LEFT_SHIFT Z  &kp X          &kp C                 &kp V                &kp B                                   &none          &none          &kp N        &kp M  &kp COMMA  &kp DOT  &mt_exit_AML_on_tap RIGHT_SHIFT QUESTION
&kp LEFT_CONTROL                  &cmd_tab_hold  &kp LG(LS(NUMBER_3))  &mt LEFT_ALT ESCAPE  &mt_exit_AML_on_tap LEFT_COMMAND SPACE  &lt 4 TAB      &kp BACKSPACE  &lt 6 ENTER                             &kp DELETE
            >;
        };

        NUMBER {
            bindings = <
&trans     &trans  &trans  &trans  &trans                         &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp N0
&kp COLON  &trans  &trans  &trans  &trans  &trans      &trans     &kp SLASH     &kp N4  &kp N5  &kp N6  &kp UNDERSCORE
&trans     &trans  &trans  &trans  &trans  &trans      &trans     &kp MINUS     &kp N1  &kp N2  &kp N3  &kp PERIOD
&trans     &trans  &trans  &trans  &trans  &trans      &kp EQUAL  &kp PLUS                              &kp COLON
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &kp DOUBLE_QUOTES  &kp AMPERSAND    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &kp TILDE          &kp DOLLAR       &kp PERCENT           &kp CARET              &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &kp SEMICOLON      &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &mt RIGHT_SHIFT GRAVE
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_BRACKET  &kp RIGHT_BRACKET                                                                &kp BACKSLASH
            >;
        };

        FN {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                   &trans               &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans               &trans               &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans               &trans               &kp F1  &kp F2  &kp F3  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &kp INTERNATIONAL_5  &kp INTERNATIONAL_4                          &trans
            >;
        };

        WIN_MOVE {
            bindings = <
&trans                   &trans              &kp LG(UP_ARROW)    &trans               &trans                      &none     &kp LS(LC(TAB))     &kp LG(TAB)     &kp LC(TAB)          &none
&kp LG(LS(RIGHT_ARROW))  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans      &trans  &none     &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &none
&trans                   &trans              &trans              &trans               &trans  &trans      &trans  &kp HOME  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END
&bt BT_CLR               &trans              &trans              &trans               &trans  &trans      &trans  &trans                                                             &none
            >;
        };

        MAC_MOVE {
            bindings = <
&trans  &trans              &kp LC(UP_ARROW)    &trans               &trans                      &trans              &kp LC(LS(TAB))       &kp LC(UP_ARROW)  &kp LC(TAB)            &trans
&trans  &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(RIGHT_ARROW)  &trans  &trans      &trans  &trans              &kp LG(LEFT_BRACKET)  &kp UP_ARROW      &kp LG(RIGHT_BRACKET)  &trans
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &kp LG(LEFT_ARROW)  &kp LEFT_ARROW        &kp DOWN_ARROW    &kp RIGHT_ARROW        &kp LG(RIGHT_ARROW)
&trans  &trans              &trans              &trans               &trans  &trans      &trans  &trans                                                                             &trans
            >;
        };

        AML {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB2  &mkp MB1  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
