#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>


&mkp_input_listener {
    input-processors = <&zip_temp_layer 5 10000>;
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball { scroll-layers = <2>; };

/ {
    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
        compatible = "zmk,macros";

        cmd_tab_hold: cmd_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "CMD_TAB_HOLD";
        };

        win_alt_tab: win_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WIN_ALT_TAB";
        };

        bt0_win: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0 &bt BT_DISC 1>;

            label = "BT0";
        };

        bt1_mac: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 0 &bt BT_DISC 0>;

            label = "BT1";
        };
    };

    combos {
        compatible = "zmk,combos";

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
        };

        win_MB2 {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN_LAYER {
            bindings = <
&kp Q         &kp W         &kp E            &kp R                &kp T                                                 &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A         &kp S         &lt 2 D          &lt 1 F              &kp G                   &none          &none          &kp H        &kp J  &lt 6 K    &kp L       &kp MINUS
&mt LSHIFT Z  &kp X         &kp C            &kp V                &kp B                   &none          &none          &kp N        &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT QUESTION
&kp LEFT_GUI  &win_alt_tab  &kp PRINTSCREEN  &mt LEFT_ALT ESCAPE  &mt LEFT_CONTROL SPACE  &lt 3 TAB      &kp BACKSPACE  &lt 4 ENTER                                &kp DELETE
            >;
        };

        NUMBER {
            bindings = <
&trans     &trans  &trans  &trans  &trans                         &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp N0
&kp COLON  &trans  &trans  &trans  &trans  &trans      &trans     &kp SLASH     &kp N4  &kp N5  &kp N6  &kp UNDERSCORE
&trans     &trans  &trans  &trans  &trans  &trans      &trans     &kp MINUS     &kp N1  &kp N2  &kp N3  &kp PERIOD
&trans     &trans  &trans  &trans  &trans  &trans      &kp EQUAL  &kp PLUS                              &kp COLON
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &kp DOUBLE_QUOTES  &kp AMPERSAND    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &kp TILDE          &kp DOLLAR       &kp PERCENT           &kp CARET              &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &kp SEMICOLON      &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &mt RIGHT_SHIFT GRAVE
&trans  &trans  &trans  &trans  &trans  &trans      &kp LEFT_BRACKET  &kp RIGHT_BRACKET                                                                &kp BACKSLASH
            >;
        };

        FN {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                   &trans               &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans               &trans               &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans               &trans               &kp F1  &kp F2  &kp F3  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &kp INTERNATIONAL_5  &kp INTERNATIONAL_4                          &trans
            >;
        };

        MOVE {
            bindings = <
&trans                   &trans              &kp LG(UP_ARROW)    &trans               &trans                      &none     &kp LS(LC(TAB))     &none           &kp LC(TAB)          &none
&kp LG(LS(RIGHT_ARROW))  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans      &trans  &none     &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &none
&trans                   &trans              &trans              &trans               &trans  &trans      &trans  &kp HOME  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END
&trans                   &trans              &trans              &trans               &trans  &trans      &trans  &trans                                                             &none
            >;
        };

        AML {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
